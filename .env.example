# Copy this file to .env and replace the placeholder locally.
# Never commit .env or put the key in a Hydra model config.
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Optional attribution headers shown in OpenRouter activity.
OPENROUTER_SITE_URL=https://github.com/paulhager/MIMIC-Clinical-Decision-Making-Framework
OPENROUTER_APP_NAME=MIMIC-CDM

# Optional campaign-wide cost ledger and hard stop. The framework records only
# model/provider/token/cost metadata here, never prompts or responses.
OPENROUTER_USAGE_LOG=runtime_data/openrouter_usage.jsonl
OPENROUTER_BUDGET_USD=80
OPENROUTER_BUDGET_RESERVE_USD=1
